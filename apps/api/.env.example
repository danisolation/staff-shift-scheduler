# Committed template for apps/api/.env (which is gitignored).
# Copy it to apps/api/.env and adjust if your setup differs.
# The values below match docker-compose.yml at the repo root.

# Dev database (docker compose service "db", host port 5434).
DATABASE_URL="postgresql://scheduler:scheduler@localhost:5434/scheduler?schema=public"

# Integration-test database (docker compose service "test-db", host port 5433).
TEST_DATABASE_URL="postgresql://scheduler:scheduler@localhost:5433/scheduler_test?schema=public"

# HTTP port the api listens on.
PORT=3000
