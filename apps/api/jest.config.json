{
  "collectCoverageFrom": ["**/*.ts", "!main.ts", "!**/*.spec.ts", "!**/test/**"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/test/load-env.ts"],
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {}]
  },
  "moduleNameMapper": {
    "^@nestjs/jwt$": "<rootDir>/test/mocks/jwt.mock.ts"
  },
  "testEnvironment": "node"
}
