{
  "collectCoverageFrom": ["src/**/*.ts", "!src/main.ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/test/load-env.ts"],
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {}]
  },
  "testEnvironment": "node"
}
